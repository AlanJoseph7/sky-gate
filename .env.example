# ──────────────────────────────────────────────────────────────────────────────
# SkyGate — Environment Configuration
#
# Copy this file to .env and fill in the values before running the server.
#
#   cp .env.example .env
#
# IMPORTANT: .env is listed in .gitignore and must NEVER be committed.
# ──────────────────────────────────────────────────────────────────────────────


# ── Required ──────────────────────────────────────────────────────────────────

# JWT signing secret — generate once and keep private.
# Run this command to generate a secure value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SKYGATE_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_ABOVE_COMMAND


# ── Optional: OpenSky Network credentials ─────────────────────────────────────
# Register free at https://opensky-network.org — unlocks 24-hour flight history.
# Leave blank to use anonymous access (2-hour window, lower rate limit).
OPENSKY_USER=
OPENSKY_PASS=


# ── Optional: server tuning ───────────────────────────────────────────────────
# SKYGATE_HOST=127.0.0.1
# SKYGATE_PORT=5000
# JWT_EXPIRE_MINUTES=30
# RATE_LIMIT_LOGIN=10/minute
# RATE_LIMIT_SIGNUP=5/minute
# MAX_LOG_ENTRIES=100
# PIPELINE_INTERVAL_SECONDS=30
